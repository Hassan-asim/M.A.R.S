# OpenRouter API Keys (4 Keys distributed across the 6 research agents)
OPENROUTER_API_KEY_1=your_openrouter_api_key_1_here
OPENROUTER_API_KEY_2=your_openrouter_api_key_2_here
OPENROUTER_API_KEY_3=your_openrouter_api_key_3_here
OPENROUTER_API_KEY_4=your_openrouter_api_key_4_here

# Fallback OpenRouter API key if individual keys aren't set
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Web Search Tool Key (Free tier Tavily API Key - optional, fallback web search available)
TAVILY_API_KEY=your_tavily_api_key_here

# Site Identification for OpenRouter Headers
OPENROUTER_SITE_URL=https://mars-research.vercel.app
OPENROUTER_SITE_NAME=M.A.R.S
