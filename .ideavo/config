{
  "systemSetup": [],
  "templateName": "custom",
  "projectDependencies": [
    {
      "name": "Install Dependencies",
      "command": "npm install"
    }
  ],
  "codeChecks": [
    {
      "name": "Run Linter",
      "command": "npm run lint"
    }
  ],
  "buildSteps": [
    {
      "name": "Build Project",
      "command": "npm run build"
    }
  ],
  "runStep": [
    {
      "name": "Run Dev Server",
      "command": "npm run dev -- --port 3000",
      "port": "3000"
    }
  ],
  "deploySteps": [
    {
      "name": "Start Production Server",
      "command": "npm run start"
    }
  ],
  "cleanupFiles": [
    ".next",
    "node_modules"
  ],
  "packageManager": "npm",
  "envPaths": [
    {
      "name": "default",
      "path": ".env"
    }
  ]
}
